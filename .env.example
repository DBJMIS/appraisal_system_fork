# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for sync and seed-user auth: SUPABASE_SERVICE_ROLE_KEY=

# Development: act as this user (must match HR/Dynamics email). e.g. dwalters@dbankjm.com
# SEED_USER_EMAIL=

# Development: set to true to bypass role checks on appraisal APIs (test full workflow as one user)
# ALLOW_APPRAISAL_TEST_BYPASS=true
# When bypass is on, set this too so the UI shows "Approve as Employee" / "Approve as Manager" (and sign-off) buttons
# NEXT_PUBLIC_ALLOW_APPRAISAL_TEST_BYPASS=true

# Optional UAT username/password login (does not change Azure AD SSO).
# Server: registers the credentials provider and verifies passwords.
# ENABLE_UAT_CREDENTIALS=true
# Client: shows the test login form on /login (must match server flag for HR testing).
# NEXT_PUBLIC_ENABLE_UAT_CREDENTIALS=true
# Set passwords: node scripts/set-uat-password.mjs leonwull@dbankjm.com "YourPassword"
# Requires app_users row + migration 0067_uat_login_credentials.sql

# NextAuth (Azure AD SSO) - required for session cookies and middleware
# If you see [next-auth][warn][NO_SECRET], set NEXTAUTH_SECRET (see below).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Generate a secret: openssl rand -base64 32
# Azure AD app registration (redirect URI: NEXTAUTH_URL/api/auth/callback/azure-ad)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# Outbound email: Microsoft Graph application permission Mail.Send + admin consent
# AZURE_FROM_EMAIL=
# Absolute base URL used for links in notification emails (e.g. https://ascend.example.com)
# NEXT_PUBLIC_APP_URL=
# Admin test emails: comma-separated allowed recipient domains (defaults to the AZURE_FROM_EMAIL domain)
# APPRAISAL_TEST_EMAIL_ALLOWED_DOMAINS=

# Appraisal reminders (daily job at /api/cron/appraisal-reminders, scheduled in vercel.json)
# Shared secret for scheduled jobs; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# CRON_SECRET=
# Days before a due date to remind (0 = on the day). Default 7,3,1,0. Whole numbers 0-60, max 10.
# APPRAISAL_REMINDER_DAYS_BEFORE=7,3,1,0
# Days after a due date to send overdue reminders, then stop. Default 1,3,7. Whole numbers 1-60, max 10.
# APPRAISAL_OVERDUE_REMINDER_DAYS=1,3,7
# How many days before the Final Review due date the one-off "Final Review available" notice may go. Default 30.
# APPRAISAL_FINAL_REVIEW_NOTICE_DAYS=30
# Days an action must stay overdue (after its overdue reminders were attempted) before HR/Admin
# see it as an escalation candidate. No escalation email is sent. Default 7. Whole number 1-90.
# APPRAISAL_ESCALATION_DAYS_OVERDUE=7

# Dynamics 365 / Dataverse (sync and HRMIS)
# DYNAMICS_TENANT_ID=
# DYNAMICS_CLIENT_ID=
# DYNAMICS_CLIENT_SECRET=
# DYNAMICS_DATAVERSE_URL=   (e.g. https://org.crm.dynamics.com)
# Optional: DYNAMICS_EMPLOYEE_ENTITY=systemusers
# Optional custom field names: DYNAMICS_FIELD_GRADE=, DYNAMICS_FIELD_DIVISION_ID=, etc.
